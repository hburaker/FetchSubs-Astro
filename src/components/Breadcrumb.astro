---
import { jsonLd } from '../data/site';

interface Props {
  /** Current page name shown after "Home ›". */
  name: string;
  /** Canonical path of the current page, e.g. "/youtube-to-srt". */
  path: string;
  /** Localized "Home". */
  homeName?: string;
}
const { name, path, homeName = 'Home' } = Astro.props;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeName, item: 'https://fetchsubs.com/' },
    { '@type': 'ListItem', position: 2, name, item: `https://fetchsubs.com${path}` },
  ],
};
---
<nav class="breadcrumb" aria-label="Breadcrumb">
  <a href="/">{homeName}</a> &rsaquo; <span aria-current="page">{name}</span>
</nav>
<script type="application/ld+json" is:inline set:html={jsonLd(schema)} />
