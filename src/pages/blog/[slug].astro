---
import Layout from '../../layouts/Layout.astro';
import { posts, stripScheduledLinks, type BlogPost } from '../../lib/blog';
import { SITE_AUTHOR, isoDate, jsonLd, longDate } from '../../data/site';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
// Long post titles + " | FetchSubs" get truncated in search results; only add the brand when it fits.
const fullTitle = post.title.length <= 48 ? `${post.title} | FetchSubs` : post.title;
const summary = post.summary;
const description = summary.length <= 160 ? summary : summary.slice(0, summary.lastIndexOf(' ', 155)) + '…';
const postUrl = `https://fetchsubs.com/blog/${post.slug}`;
const published = isoDate(post.publishDate);
const modified = isoDate(post.lastModified);
const showUpdated = !!post.updatedDate && post.updatedDate > post.publishDate;

const article: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: summary,
  datePublished: published,
  dateModified: modified,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  url: postUrl,
  ...(post.cover ? { image: `https://fetchsubs.com${post.cover}` } : {}),
  author: { '@type': 'Person', name: post.author || SITE_AUTHOR, url: 'https://fetchsubs.com/about' },
  publisher: { '@id': 'https://fetchsubs.com/#organization' },
  inLanguage: post.lang,
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fetchsubs.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://fetchsubs.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
  ],
};
const related = posts.filter((p) => p.slug !== post.slug).slice(0, 3);
---
<Layout
  title={post.title}
  fullTitle={fullTitle}
  description={description}
  ogType="article"
  canonicalPath={`/blog/${post.slug}`}
  ogImage={post.cover}
  lang={post.lang}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <script type="application/ld+json" is:inline set:html={jsonLd(article)} />
    <script type="application/ld+json" is:inline set:html={jsonLd(breadcrumb)} />
  </Fragment>

  <article class="doc-page blog-post">
    <div class="post-header">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> &rsaquo; <a href="/blog">Blog</a>
      </nav>
      <time class="blog-date" datetime={published}>{longDate(post.publishDate)}</time>
      {showUpdated && <div class="post-meta">Updated <time datetime={modified}>{longDate(post.updatedDate!)}</time></div>}
      <h1>{post.title}</h1>
      <div class="post-meta">By <a href="/about" rel="author"><strong>{post.author}</strong></a></div>
    </div>

    {post.cover && <img src={post.cover} alt="" class="post-img" width="1200" height="630" loading="eager" fetchpriority="high" />}

    <div class="post-content" set:html={stripScheduledLinks(post.content)} />

    <aside class="landing-note post-cta">
      <strong>Try it yourself:</strong> paste any YouTube link into
      <a href="/">FetchSubs</a> to download its subtitles as SRT, VTT or TXT for free, or jump straight to the
      <a href="/youtube-transcript">YouTube transcript generator</a>, the
      <a href="/youtube-to-srt">YouTube to SRT converter</a> or
      <a href="/youtube-to-text">YouTube to text</a>.
    </aside>

    {related.length > 0 && (
      <section class="related-posts" aria-labelledby="related-posts-title">
        <h2 id="related-posts-title">Related Articles</h2>
        <ul>
          {related.map((p) => <li><a href={`/blog/${p.slug}`}>{p.title}</a></li>)}
        </ul>
      </section>
    )}
  </article>
</Layout>

<style is:global>
  .blog-post { max-width: 800px; margin: 0 auto; }
  .post-header { margin-bottom: 2rem; }
  .post-header .blog-date { display: block; }
  .post-header h1 { font-size: 2.5rem; margin: 0.5rem 0; line-height: 1.2; }
  .post-meta { color: var(--text-muted); font-size: 0.9rem; }
  .post-img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-radius: 1rem;
    margin-bottom: 2.5rem;
    border: 1px solid var(--glass-border);
  }
  .post-content { font-size: 1.1rem; line-height: 1.8; }
  .post-content h3 { color: var(--text-main); margin: 2.5rem 0 1rem; font-size: 1.5rem; }
  .post-content p { margin-bottom: 1.5rem; color: var(--text-muted); }
  .post-content i { color: var(--accent-primary); font-style: normal; font-weight: 600; }
  .post-cta a, .related-posts a { color: var(--accent-primary); }
  .related-posts { margin-top: 2.5rem; }
  .related-posts h2 { font-size: 1.4rem; margin-bottom: 1rem; }
  .related-posts ul { list-style: none; display: grid; gap: 0.75rem; }
  @media (max-width: 768px) {
    .post-header h1 { font-size: 1.8rem; }
  }
</style>
