---
import Layout from '../layouts/Layout.astro';
import { jsonLd } from '../data/site';

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is it legal to download YouTube subtitles?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Downloading subtitles is generally allowed when the content is publicly available and you have permission from the content owner. FetchSubs is designed to help users extract subtitle files for personal, educational, and accessibility purposes. We recommend respecting YouTube's Terms of Service and the rights of original creators at all times.",
      },
    },
    {
      '@type': 'Question',
      name: 'Can I download automatically generated YouTube captions?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. If a YouTube video has auto-generated captions available, FetchSubs can retrieve them and convert them into supported formats such as SRT, VTT, or TXT. The availability depends on whether captions exist for that specific video.',
      },
    },
    {
      '@type': 'Question',
      name: 'What subtitle formats are supported?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'FetchSubs currently supports SRT (SubRip Subtitle), VTT (WebVTT), TXT (Plain Text), and RAW Transcript formats. This flexibility allows you to use subtitles for editing, translation, SEO optimization, or content repurposing.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to create an account to use FetchSubs?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. FetchSubs does not require registration or account creation. Simply paste the YouTube video URL into the input box and generate subtitles instantly.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is FetchSubs free to use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, FetchSubs is completely free to use. There are no hidden fees, subscriptions, or download limits for standard usage.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does FetchSubs store my video links or data?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. FetchSubs does not store personal data, video content, or downloaded subtitle files. The tool processes the request in real time and does not maintain a database of user activity.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why are subtitles important for video content?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Subtitles improve accessibility for hearing-impaired viewers and non-native speakers. They also enhance watch time, engagement, and search visibility. Many content creators use subtitles to improve video SEO, repurpose content into blog posts, and expand their audience globally.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I use downloaded subtitles for translation or editing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Downloaded subtitle files (SRT or VTT) can be edited using common subtitle editors or text editors. This allows you to translate content, fix timing, or repurpose transcripts for articles, captions, or summaries.',
      },
    },
  ],
};
---
<Layout
  title="FAQ - Frequently Asked Questions"
  description="Find answers to frequently asked questions about FetchSubs. Learn about legalities, format support (SRT, VTT, TXT), auto-generated captions, and data privacy."
>
<script type="application/ld+json" is:inline set:html={jsonLd(faqPage)} />

<style is:global>
    /* Inline styles to guarantee application and avoid encoding issues with external file */
    .faq-page {
        max-width: 850px;
        margin: 0 auto;
        padding-bottom: 5rem;
    }

    .faq-hero {
        text-align: center;
        margin-bottom: 4rem;
    }

    .faq-hero h1 {
        font-size: 3rem;
        font-weight: 800;
        margin-bottom: 1rem;
        background: linear-gradient(to right, #fff, var(--accent-primary));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .faq-hero p {
        color: var(--text-muted);
        font-size: 1.2rem;
        line-height: 1.6;
    }

    .faq-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .faq-item {
        background: rgba(30, 41, 59, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 1rem;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .faq-item:hover {
        border-color: var(--accent-primary);
        background: rgba(30, 41, 59, 0.7);
    }

    .faq-item.faq-open {
        border-color: var(--accent-primary);
        box-shadow: 0 0 20px rgba(56, 189, 248, 0.1);
    }

    .faq-heading { margin: 0; font-size: inherit; font-weight: inherit; }
    .faq-question {
        width: 100%;
        background: none;
        border: none;
        color: #fff;
        padding: 1.5rem 2rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        text-align: left;
    }

    .faq-question-text {
        flex: 1;
        padding-right: 1rem;
    }

    .faq-chevron {
        font-size: 1.5rem;
        color: var(--text-muted);
        transition: transform 0.3s ease;
    }

    .faq-open .faq-chevron {
        transform: rotate(90deg);
        color: var(--accent-primary);
    }

    .faq-answer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s cubic-bezier(0, 1, 0, 1);
    }

    .faq-open .faq-answer {
        max-height: 1000px;
        transition: max-height 0.4s ease-in;
    }

    .faq-answer-inner {
        padding: 0 2rem 2rem 2rem;
        color: var(--text-muted);
        line-height: 1.7;
    }

    .faq-answer-inner ul {
        margin: 1rem 0;
        padding-left: 1.5rem;
    }

    .faq-answer-inner li {
        margin-bottom: 0.5rem;
    }

    .faq-answer-inner strong {
        color: #fff;
    }

    .faq-cta {
        margin-top: 4rem;
        text-align: center;
        padding: 3rem;
        background: rgba(30, 41, 59, 0.3);
        border-radius: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .faq-cta a {
        color: var(--accent-primary);
        text-decoration: none;
        font-weight: 700;
    }

    @media (max-width: 768px) {
        .faq-hero h1 { font-size: 2rem; }
        .faq-question { padding: 1.25rem; font-size: 1rem; }
    }
</style>

<div class="faq-page">
    <div class="faq-hero">
        <h1>Frequently Asked Questions</h1>
        <p>Everything you need to know about FetchSubs - answered clearly and honestly.</p>
    </div>

    <div class="faq-list">
        <!-- Q1 -->
        <div class="faq-item">
            <h2 class="faq-heading"><button class="faq-question" type="button" aria-expanded="false">
                <span class="faq-question-text">Is it legal to download YouTube subtitles?</span>
                <span class="faq-chevron">&gt;</span>
            </button></h2>
            <div class="faq-answer">
                <div class="faq-answer-inner">
                    <p>Downloading subtitles is generally allowed when the content is publicly available and you have permission from the content owner. FetchSubs is designed to help users extract subtitle files for <strong>personal, educational, and accessibility purposes</strong>.</p>
                    <p>We recommend respecting YouTube's Terms of Service and the rights of original creators at all times.</p>
                </div>
            </div>
        </div>

        <!-- Q2 -->
        <div class="faq-item">
            <h2 class="faq-heading"><button class="faq-question" type="button" aria-expanded="false">
                <span class="faq-question-text">Can I download automatically generated YouTube captions?</span>
                <span class="faq-chevron">&gt;</span>
            </button></h2>
            <div class="faq-answer">
                <div class="faq-answer-inner">
                    <p><strong>Yes.</strong> If a YouTube video has auto-generated captions available, FetchSubs can retrieve them and convert them into supported formats such as SRT, VTT, or TXT.</p>
                    <p>The availability depends on whether captions exist for that specific video.</p>
                </div>
            </div>
        </div>

        <!-- Q3 -->
        <div class="faq-item">
            <h2 class="faq-heading"><button class="faq-question" type="button" aria-expanded="false">
                <span class="faq-question-text">What subtitle formats are supported?</span>
                <span class="faq-chevron">&gt;</span>
            </button></h2>
            <div class="faq-answer">
                <div class="faq-answer-inner">
                    <p>FetchSubs currently supports the following subtitle formats:</p>
                    <ul>
                        <li><strong>SRT (SubRip Subtitle)</strong> - Widely used format compatible with most media players.</li>
                        <li><strong>VTT (WebVTT)</strong> - Commonly used for HTML5 video players and web platforms.</li>
                        <li><strong>TXT (Plain Text)</strong> - Clean transcript version without timestamps.</li>
                        <li><strong>RAW Transcript</strong> - View the unprocessed subtitle content directly online.</li>
                    </ul>
                    <p>This flexibility allows you to use subtitles for editing, translation, SEO optimization, or content repurposing.</p>
                </div>
            </div>
        </div>

        <!-- Q4 -->
        <div class="faq-item">
            <h2 class="faq-heading"><button class="faq-question" type="button" aria-expanded="false">
                <span class="faq-question-text">Do I need to create an account to use FetchSubs?</span>
                <span class="faq-chevron">&gt;</span>
            </button></h2>
            <div class="faq-answer">
                <div class="faq-answer-inner">
                    <p><strong>No.</strong> FetchSubs does not require registration or account creation. Simply paste the YouTube video URL into the input box and generate subtitles instantly.</p>
                    <p>This makes the tool fast, simple, and accessible for everyone.</p>
                </div>
            </div>
        </div>

        <!-- Q5 -->
        <div class="faq-item">
            <h2 class="faq-heading"><button class="faq-question" type="button" aria-expanded="false">
                <span class="faq-question-text">Is FetchSubs free to use?</span>
                <span class="faq-chevron">&gt;</span>
            </button></h2>
            <div class="faq-answer">
                <div class="faq-answer-inner">
                    <p><strong>Yes, FetchSubs is completely free to use.</strong> There are no hidden fees, subscriptions, or download limits for standard usage.</p>
                    <p>Our goal is to provide a simple and efficient subtitle extraction solution for creators, students, and researchers.</p>
                </div>
            </div>
        </div>

        <!-- Q6 -->
        <div class="faq-item">
            <h2 class="faq-heading"><button class="faq-question" type="button" aria-expanded="false">
                <span class="faq-question-text">Does FetchSubs store my video links or data?</span>
                <span class="faq-chevron">&gt;</span>
            </button></h2>
            <div class="faq-answer">
                <div class="faq-answer-inner">
                    <p><strong>No.</strong> FetchSubs does not store personal data, video content, or downloaded subtitle files. The tool processes the request in real time and does not maintain a database of user activity.</p>
                    <p>For more details, please refer to our <a href="/privacy">Privacy Policy</a> page.</p>
                </div>
            </div>
        </div>

        <!-- Q7 -->
        <div class="faq-item">
            <h2 class="faq-heading"><button class="faq-question" type="button" aria-expanded="false">
                <span class="faq-question-text">Why are subtitles important for video content?</span>
                <span class="faq-chevron">&gt;</span>
            </button></h2>
            <div class="faq-answer">
                <div class="faq-answer-inner">
                    <p>Subtitles improve accessibility for <strong>hearing-impaired viewers</strong> and non-native speakers. They also enhance watch time, engagement, and search visibility.</p>
                    <p>Many content creators use subtitles to improve video SEO, repurpose content into blog posts, and expand their audience globally.</p>
                </div>
            </div>
        </div>

        <!-- Q8 -->
        <div class="faq-item">
            <h2 class="faq-heading"><button class="faq-question" type="button" aria-expanded="false">
                <span class="faq-question-text">Can I use downloaded subtitles for translation or editing?</span>
                <span class="faq-chevron">&gt;</span>
            </button></h2>
            <div class="faq-answer">
                <div class="faq-answer-inner">
                    <p><strong>Yes.</strong> Downloaded subtitle files (SRT or VTT) can be edited using common subtitle editors or text editors. This allows you to translate content, fix timing, or repurpose transcripts for articles, captions, or summaries.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="faq-cta">
        <p>Still have a question? Visit our <a href="/usage">How to Use</a> guide or head back to the <a href="/">homepage</a> to try it yourself.</p>
    </div>
</div>

<script>
    document.querySelectorAll('.faq-question').forEach(function(btn) {
        btn.addEventListener('click', function() {
            const item = this.closest(".faq-item");
            const open = item.classList.toggle("faq-open");
            this.setAttribute("aria-expanded", open ? "true" : "false");
        });
    });
</script>
</Layout>
